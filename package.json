{
  "name": "@local/usage-balance",
  "version": "1.0.0",
  "private": true,
  "description": "Shows the DeepSeek account balance and this session's token usage in the session header",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junyuecao/dsh-usage-balance.git"
  },
  "homepage": "https://github.com/junyuecao/dsh-usage-balance#readme",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
